# Copy to .env.local (ignored by git) and fill in what you have. All are optional:
# the app works without them, with the matching feature switched off.

# Your LiveFit server's public address, e.g. https://api.example.com
EXPO_PUBLIC_API_URL=

# Crash reports (Sentry project DSN).
EXPO_PUBLIC_SENTRY_DSN=

# Google Maps for Android/iOS. Without it, routes are drawn as lines.
GOOGLE_MAPS_API_KEY=
