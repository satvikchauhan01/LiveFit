# Copy this file to .env and fill it in. Never commit .env.

NODE_ENV=development
PORT=4000

# The local database from docker-compose.yml. In production, your host's Postgres URL.
DATABASE_URL=postgres://livefit:livefit@localhost:5432/livefit

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# The address the server is reachable at (links in emails point here).
APP_URL=http://localhost:4000

# Email sending. Leave SMTP_URL empty to print emails to the console instead.
SMTP_URL=
MAIL_FROM=LiveFit <no-reply@example.com>

# AI coach (optional): a Claude API key, and a monthly spending cap in US dollars.
ANTHROPIC_API_KEY=
COACH_MONTHLY_BUDGET_USD=20

# LiveFit Pro purchase checks (optional): Google Play service-account JSON on one line.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
ANDROID_PACKAGE_NAME=com.livefit.app
# A long random string; the Play notifications push URL ends with ?secret=<this>.
GOOGLE_PLAY_RTDN_SECRET=

# Comma-separated emails with moderator access.
ADMIN_EMAILS=
